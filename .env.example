# AgriMultimodalQA - Environment Variables
# Copy this to .env and fill in values

# ── API Settings ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Frontend Settings ─────────────────────────────────────────
API_BASE_URL=http://localhost:8000

# ── Weather API ────────────────────────────────────────────────
# NASA POWER API is FREE - no key needed
# Just leave these as defaults

# ── Model Paths ───────────────────────────────────────────────
# Set these after training your models
INTENT_MODEL_PATH=./models/intent_classifier
NER_MODEL_PATH=./models/ner_model
IMAGE_MODEL_PATH=./models/image/efficientnet_b3.pth
GENERATOR_MODEL_PATH=./models/generator

# ── Knowledge Graph ───────────────────────────────────────────
KG_PATH=./data/processed/kg_triples/agri_kg.json

# ── Kaggle (for dataset download) ───────────────────────────
# Get from https://www.kaggle.com/account
KAGGLE_USERNAME=your_username
KAGGLE_KEY=your_api_key

# ── Neo4j (optional, for larger KG) ──────────────────────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
